# Copie para .env.local e preencha:  cp .env.example .env.local && chmod 600 .env.local

# Caminho onde o painel fica publicado no Apache (precisa rodar "npm run build" de novo se mudar)
PAINEL_BASE_PATH=/painel

# Senha de acesso ao painel
PAINEL_SENHA=troque-esta-senha

# Chave que assina o cookie de login. Gere com:  openssl rand -hex 32
PAINEL_SEGREDO=

# Pasta dos scripts do servidor
PAINEL_SCRIPTS_DIR=/opt/server-scripts

# 1 = chama os scripts com "sudo -n" (o normal em produção, ver sudoers no guia)
PAINEL_SUDO=1

# Onde o painel guarda o histórico de execuções e os logs das tarefas que você disparou
PAINEL_DADOS_DIR=./dados

# Horas de duração do login
PAINEL_SESSAO_HORAS=12
